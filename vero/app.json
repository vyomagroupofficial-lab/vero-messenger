{
  "expo": {
    "name": "Vero",
    "slug": "vero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "vero",
    "splash": {
      "backgroundColor": "#050A14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vero.messenger",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050A14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vero.messenger",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Vero Messenger",
      "shortName": "Vero",
      "description": "Private, end-to-end encrypted messenger.",
      "themeColor": "#050A14",
      "backgroundColor": "#050A14",
      "display": "standalone",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Vero uses the microphone to record voice messages and videos you send end-to-end encrypted.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#06B6D4"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vero needs access to your photos so you can send them end-to-end encrypted.",
          "cameraPermission": "Vero needs camera access so you can take photos to send end-to-end encrypted.",
          "microphonePermission": "Vero uses the microphone to record voice messages and videos you send end-to-end encrypted."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Vero uses the camera to scan QR codes (adding contacts, linking devices) and to take photos you send end-to-end encrypted.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Vero checks which of your contacts use Vero. Only short hash prefixes leave your device, never names or numbers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
