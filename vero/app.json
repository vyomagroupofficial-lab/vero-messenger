{
  "expo": {
    "name": "Vero",
    "slug": "vero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "vero",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0E0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vero.messenger"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D6A657",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vero.messenger"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vero accesses your photos to send encrypted media.",
          "cameraPermission": "Vero accesses your camera to take photos and videos."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Vero accesses your microphone to record voice messages."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
