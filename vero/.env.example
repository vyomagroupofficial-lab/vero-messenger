# Vero Messenger Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ──────────────────────────────────────────────────────────────────────────
# Supabase (get these from your Supabase project settings)
# ──────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ──────────────────────────────────────────────────────────────────────────
# Google Drive (for encrypted media storage)
# Use a backend Edge Function to proxy Drive API calls
# NEVER put service account credentials here
# ──────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# ──────────────────────────────────────────────────────────────────────────
# WebRTC / TURN Server (for calls)
# ──────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_TURN_SERVER_URL=turn:your-turn-server.com:3478
EXPO_PUBLIC_TURN_USERNAME=your-turn-username
EXPO_PUBLIC_TURN_CREDENTIAL=your-turn-credential

# ──────────────────────────────────────────────────────────────────────────
# Push Notifications (FCM Server Key stays server-side!)
# ──────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_FCM_SENDER_ID=your-firebase-sender-id

# ──────────────────────────────────────────────────────────────────────────
# DO NOT ADD ANY OF THESE TO THIS FILE:
# - Supabase service role key
# - Google service account JSON
# - FCM server key
# - Any private keys
# These belong in Supabase Edge Function secrets ONLY
# ──────────────────────────────────────────────────────────────────────────
