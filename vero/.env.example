# Vero client configuration. Copy to `.env` (never commit `.env`).
# Only PUBLIC values belong here: everything prefixed EXPO_PUBLIC_ is bundled
# into the app and can be read by anyone who has it.

# Supabase project URL and anon/publishable key (Project Settings -> API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: host for https invite links (https://<host>/join/<token>). Without
# it, invite links use vero://join/<token>. See README -> "Invite links".
# EXPO_PUBLIC_INVITE_HOST=vero.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Server-side secrets are NOT set here. Configure them as Edge Function secrets:
#
#   supabase secrets set PUSH_WEBHOOK_SECRET=$(openssl rand -hex 32)
#   supabase secrets set CRON_SECRET=$(openssl rand -hex 32)
#
#   # Optional: store encrypted attachments in Google Drive instead of the
#   # private Supabase Storage bucket (the default).
#   supabase secrets set VERO_MEDIA_BACKEND=drive
#   supabase secrets set GOOGLE_SERVICE_ACCOUNT_JSON="$(cat service-account.json)"
#   supabase secrets set GOOGLE_DRIVE_FOLDER_ID=<folder id inside a Shared Drive>
#
# Never put the service-role key, service-account JSON or TURN credentials in
# an EXPO_PUBLIC_ variable.
# ─────────────────────────────────────────────────────────────────────────────
